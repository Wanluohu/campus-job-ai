<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <text class="header-title">Claude 助手</text>
    <view class="header-actions">
      <text class="header-btn" bindtap="goToHistory">历史</text>
      <text class="header-btn" bindtap="newChat">新建</text>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view
    class="msg-list"
    scroll-y
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
  >
    <!-- 空状态 -->
    <view class="empty-hint" wx:if="{{messages.length === 0}}">
      <text class="empty-icon">🤖</text>
      <text class="empty-text">开始和 Claude 对话吧</text>
    </view>

    <!-- 消息气泡 -->
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{item.id}}"
      class="msg-item {{item.role}}"
    >
      <view class="bubble {{item.role}}">
        <text class="bubble-text" selectable>{{item.content}}</text>
      </view>
    </view>

    <!-- 加载指示器 -->
    <view class="loading-indicator" wx:if="{{loading}}">
      <view class="typing-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view class="input-bar">
    <input
      class="msg-input"
      value="{{inputValue}}"
      placeholder="输入消息..."
      placeholder-class="input-placeholder"
      bindinput="onInput"
      bindconfirm="sendMessage"
      confirm-type="send"
      disabled="{{loading}}"
      auto-focus
    />
    <button class="send-btn {{inputValue ? 'active' : ''}}" bindtap="sendMessage" disabled="{{loading || !inputValue}}">
      发送
    </button>
  </view>
</view>
