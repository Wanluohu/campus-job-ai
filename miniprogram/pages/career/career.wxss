.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
}

/* 顶部标题 */
.header {
  text-align: center;
  padding: 50rpx 0 40rpx;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 功能卡片 */
.card-list {
  margin-top: 20rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.2s;
}

.feature-card:active {
  transform: scale(0.98);
}

.card-icon {
  font-size: 52rpx;
  margin-right: 24rpx;
  width: 72rpx;
  text-align: center;
}

.card-body {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.card-desc {
  display: block;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.card-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 12rpx;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
  padding: 40rpx 0;
}

.tip-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}
