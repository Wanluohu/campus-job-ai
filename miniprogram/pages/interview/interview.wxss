.container {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}

.nav-back {
  font-size: 28rpx;
  color: #667eea;
  width: 120rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.nav-placeholder {
  width: 120rpx;
}

/* ==================== 设置阶段 ==================== */
.setup-section {
  flex: 1;
  padding: 40rpx 30rpx;
}

.setup-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 36rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.setup-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.setup-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.setup-desc {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 40rpx;
}

.form-group {
  text-align: left;
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.picker-value {
  background: #f5f5f5;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.difficulty-options {
  display: flex;
  gap: 16rpx;
}

.diff-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #666;
  transition: all 0.2s;
}

.diff-active {
  background: #667eea;
  color: #fff;
  font-weight: 600;
}

.tips-box {
  background: #f0f4ff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: left;
  margin-bottom: 30rpx;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #667eea;
  margin-bottom: 12rpx;
}

.tips-item {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}

.btn-start {
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

/* ==================== 面试阶段 ==================== */
.chat-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.msg-list {
  flex: 1;
  padding: 20rpx 24rpx;
}

.interview-banner {
  text-align: center;
  padding: 16rpx 24rpx;
  background: #f0f4ff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #667eea;
}

/* 消息 */
.msg-item {
  display: flex;
  margin-bottom: 30rpx;
}

.msg-item.user {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.msg-item.interviewer .msg-avatar {
  margin-right: 12rpx;
}

.msg-item.user .msg-avatar {
  margin-left: 12rpx;
}

.bubble {
  max-width: 75%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.bubble.interviewer {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 6rpx;
}

.bubble.user {
  background: #667eea;
  color: #fff;
  border-bottom-right-radius: 6rpx;
}

.bubble-text {
  white-space: pre-wrap;
}

/* 完成横幅 */
.complete-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.complete-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.complete-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.btn-restart {
  padding: 20rpx 60rpx;
  background: #667eea;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

/* 加载动画 */
.loading-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.loading-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.typing-dots {
  display: flex;
  gap: 12rpx;
}

.typing-dots .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #667eea;
  animation: bounce 1.4s infinite ease-in-out both;
}

.typing-dots .dot:nth-child(1) { animation-delay: -0.32s; }
.typing-dots .dot:nth-child(2) { animation-delay: -0.16s; }
.typing-dots .dot:nth-child(3) { animation-delay: 0s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* 底部输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: env(safe-area-inset-bottom);
}

.msg-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #333;
}

.input-placeholder {
  color: #bbb;
}

.send-btn {
  margin-left: 16rpx;
  height: 72rpx;
  padding: 0 30rpx;
  background: #ddd;
  color: #999;
  font-size: 28rpx;
  border-radius: 36rpx;
  border: none;
  display: flex;
  align-items: center;
  line-height: 1;
}

.send-btn.active {
  background: #667eea;
  color: #fff;
}

.send-btn[disabled] {
  opacity: 0.5;
}
