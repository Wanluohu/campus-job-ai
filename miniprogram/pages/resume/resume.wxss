.container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav-back {
  font-size: 28rpx;
  color: #667eea;
  width: 120rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.nav-placeholder {
  width: 120rpx;
}

/* 输入区域 */
.input-section {
  padding: 30rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.resume-textarea {
  width: 100%;
  min-height: 400rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid #e0e0e0;
}

.resume-textarea:focus {
  border-color: #667eea;
}

.textarea-placeholder {
  color: #bbb;
}

.input-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn-paste, .btn-clear {
  flex: 1;
  font-size: 26rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  border: 2rpx solid #ddd;
  background: #fff;
  color: #666;
  text-align: center;
}

.word-count {
  text-align: right;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}

.btn-analyze {
  width: 100%;
  margin-top: 30rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}

.btn-disabled {
  opacity: 0.6;
}

/* 加载动画 */
.loading-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.loading-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #888;
}

.typing-dots {
  display: flex;
  gap: 12rpx;
}

.typing-dots .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #667eea;
  animation: bounce 1.4s infinite ease-in-out both;
}

.typing-dots .dot:nth-child(1) { animation-delay: -0.32s; }
.typing-dots .dot:nth-child(2) { animation-delay: -0.16s; }
.typing-dots .dot:nth-child(3) { animation-delay: 0s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* 结果展示 */
.result-section {
  padding: 0 30rpx;
}

/* 评分卡片 */
.score-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.score-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
}

.score-number {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.1;
}

.score-unit {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.score-label {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 结果块 */
.result-block {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

.block-item {
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.optimized-content {
  background: #f8f9ff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #667eea;
}

.optimized-text {
  font-size: 26rpx;
  line-height: 1.9;
  color: #333;
  white-space: pre-wrap;
}

.btn-copy {
  width: 100%;
  padding: 20rpx;
  background: #667eea;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
}

.btn-reanalyze {
  width: 100%;
  padding: 24rpx;
  background: #fff;
  color: #667eea;
  font-size: 28rpx;
  border-radius: 16rpx;
  border: 2rpx solid #667eea;
  margin-bottom: 30rpx;
}
