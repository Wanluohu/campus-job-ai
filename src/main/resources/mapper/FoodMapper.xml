<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.mydemo.repository.FoodRepository">

    <resultMap id="BaseResultMap" type="org.example.mydemo.entity.Food">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="price" column="price" jdbcType="VARCHAR"/>
        <result property="quantity" column="quantity" jdbcType="VARCHAR"/>
        <result property="state" column="state" jdbcType="VARCHAR"/>
        <result property="type" column="type" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 查询单条 -->
    <select id="findFood" resultMap="BaseResultMap">
        select id, name, price, quantity, state, type
        from food
        where id = #{id}
    </select>

    <!-- 查询全部 -->
    <select id="queryAll" resultMap="BaseResultMap">
        select id, name, price, quantity, state, type
        from food
    </select>

    <!-- 插入 -->
    <insert id="insertOne" parameterType="org.example.mydemo.entity.Food">
        insert into food (name, type, state, price, quantity)
        values (#{name}, #{type}, #{state}, #{price}, #{quantity})
    </insert>

    <!-- 更新库存 -->
    <update id="updateById">
        update food
        set quantity = #{price}
        where id = #{id}
    </update>

    <!-- 删除 -->
    <delete id="deleteById">
        delete from food
        where id = #{id}
    </delete>

</mapper>
