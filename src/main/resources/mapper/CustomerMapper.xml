<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.mydemo.repository.CustomerRepository">

    <resultMap id="BaseResultMap" type="org.example.mydemo.entity.Customer">
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="gender" column="gender" jdbcType="VARCHAR"/>
        <result property="age" column="age" jdbcType="INTEGER"/>
        <result property="address" column="address" jdbcType="VARCHAR"/>
        <result property="phone" column="phone" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 按ID查询 -->
    <select id="findById" resultMap="BaseResultMap">
        select id, name, gender, age, address, phone
        from customer
        where id = #{id}
    </select>

    <!-- 查询全部 -->
    <select id="queryAll" resultMap="BaseResultMap">
        select id, name, gender, age, address, phone
        from customer
    </select>

    <!-- 插入客户 -->
    <insert id="insertOne" parameterType="org.example.mydemo.entity.Customer">
        insert into customer (name, gender, age, address, phone)
        values (#{name}, #{gender}, #{age}, #{address}, #{phone})
    </insert>

    <!-- 按ID更新地址 -->
    <update id="updateById">
        update customer
        set address = #{address}
        where id = #{id}
    </update>

    <!-- 按ID删除 -->
    <delete id="deleteById">
        delete from customer
        where id = #{id}
    </delete>

</mapper>
